{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "tray-popup"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "git", "cmd": "git", "args": true },
        { "name": "pnpm", "cmd": "pnpm", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "go", "cmd": "go", "args": true },
        { "name": "gh", "cmd": "gh", "args": true },
        { "name": "docker", "cmd": "docker", "args": true },
        { "name": "which", "cmd": "which", "args": true },
        { "name": "lsof", "cmd": "lsof", "args": true },
        { "name": "ps", "cmd": "ps", "args": true },
        { "name": "kill", "cmd": "kill", "args": true },
        { "name": "pgrep", "cmd": "pgrep", "args": true },
        { "name": "pkill", "cmd": "pkill", "args": true },
        { "name": "sysctl", "cmd": "sysctl", "args": true },
        { "name": "open", "cmd": "open", "args": true },
        { "name": "pbcopy", "cmd": "pbcopy", "args": true },
        { "name": "osascript", "cmd": "osascript", "args": true },
        { "name": "sh", "cmd": "sh", "args": true }
      ]
    },
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-show",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "global-shortcut:default",
    "global-shortcut:allow-register"
  ]
}
